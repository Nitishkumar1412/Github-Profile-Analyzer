# Optional: raises GitHub API limit from 60 to 5000 requests/hour.
# Use a token with NO scopes, and only for local use (Vite exposes it to the browser).
VITE_GITHUB_TOKEN=

# Optional: enables a real LLM for the AI summary (free Hugging Face token with "Inference Providers" permission).
# Without it, the app uses its built-in rule-based insights. Local use only.
VITE_HF_TOKEN=
